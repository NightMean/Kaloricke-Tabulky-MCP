# Quote every value. Passwords routinely contain characters ( ) ^ $ ! that
# the shell would otherwise interpret when you `source` this file.

# --- kaloricketabulky.cz / kaloricketabulky.sk account (the diary these tools write to) ---
KT_EMAIL=you@example.com
KT_PASSWORD=your-kaloricketabulky-password
# Optional: defaults to kaloricketabulky.cz, set to kaloricketabulky.sk for Slovak accounts
KT_DOMAIN=kaloricketabulky.cz
# Alternative base URL: used only when KT_DOMAIN is unset or blank.
# KT_BASE_URL=https://www.kaloricketabulky.sk

# Stdio mode needs only the KT settings above. Everything below is HTTP-only.
# Local setup and Hermes configuration: docs/LOCAL-MCP.md

# --- Who is allowed to connect this MCP server to Claude (HTTP mode) ---
# You type this in the browser during the OAuth consent step. Make it long.
MCP_AUTH_PASSWORD=change-me-to-a-long-random-passphrase

# --- Public identity of this server ---
# The HTTPS URL your Cloudflare tunnel maps to this container. Used as the
# OAuth issuer, the RFC 8707 resource identifier, and for Origin validation.
# It must match the tunnel's public hostname exactly — scheme and host, no
# path, no trailing slash. Changing it invalidates issued tokens, so you
# reconnect the connector in Claude once after a change.
PUBLIC_URL=https://kt-mcp.example.com

# The same host without the scheme. nginx substitutes this into its server_name.
MCP_HOSTNAME=kt-mcp.example.com

# --- Local bind (the tunnel connects here; do not expose this port publicly) ---
PORT=8092

# Where issued tokens and registered OAuth clients are persisted, so a redeploy
# doesn't force you to reconnect the connector. The Docker stack overrides this
# to /data (backed by a volume); ./data is the safe default for running locally.
STATE_DIR=./data
