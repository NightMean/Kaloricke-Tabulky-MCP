{
  "name": "kaloricke-tabulky-mcp",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "MCP server exposing kaloricketabulky.cz food logging to AI agents",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NightMean/Kaloricke-Tabulky-MCP.git"
  },
  "bugs": "https://github.com/NightMean/Kaloricke-Tabulky-MCP/issues",
  "homepage": "https://github.com/NightMean/Kaloricke-Tabulky-MCP#readme",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "kaloricke-tabulky-mcp": "dist/cli.js"
  },
  "files": [
    "dist/**/*.js",
    "!dist/**/*.test.js",
    "README.en.md",
    "HOSTING.md",
    "docs/*.md",
    ".env.example"
  ],
  "scripts": {
    "build": "tsc",
    "build:release": "tsc -p tsconfig.release.json",
    "prepack": "npm run build:release",
    "start": "node dist/index.js",
    "start:stdio": "node dist/stdio.js",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test \"dist/**/*.test.js\"",
    "test:package": "node --test test/package.test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "typescript": "^5.9.3"
  }
}
